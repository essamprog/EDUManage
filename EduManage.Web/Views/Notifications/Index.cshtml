@using EduManage.Application.DTOs.System
@model IEnumerable<NotificationDto>

@{
    ViewData["Title"] = "Notifications";
    var list = Model.ToList();
    var unreadCount = list.Count(n => !n.IsRead);
}

<div class="notifications-page">

    @* ── Page Header ─────────────────────────── *@
    <div class="notif-hero">
        <div class="container">
            <div class="notif-hero-content">
                <span class="notif-badge"><i class="bi bi-bell-fill"></i> NOTIFICATIONS</span>
                <h1 class="notif-hero-title">Your Notifications</h1>
                <p class="notif-hero-sub">Stay up to date with your courses, purchases, and platform updates.</p>
            </div>
        </div>
    </div>

    @* ── Content ──────────────────────────────── *@
    <div class="container notif-body">

        @* Stats bar *@
        <div class="notif-stats-bar">
            <span><i class="bi bi-bell text-primary me-1"></i> <strong>@list.Count</strong> Total</span>
            @if (unreadCount > 0)
            {
                <span class="unread-count"><i class="bi bi-circle-fill text-danger me-1" style="font-size:0.5rem;vertical-align:middle;"></i> <strong>@unreadCount</strong> Unread</span>
            }
            else
            {
                <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i> All caught up!</span>
            }

            @if (unreadCount > 0)
            {
                <form asp-action="MarkAllRead" method="post" class="ms-auto d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-mark-all">
                        <i class="bi bi-check2-all me-1"></i> Mark all as read
                    </button>
                </form>
            }
        </div>

        @* Notification list *@
        @if (!list.Any())
        {
            <div class="notif-empty">
                <div class="empty-icon"><i class="bi bi-bell-slash"></i></div>
                <h3>No notifications yet</h3>
                <p>When you get notifications, they'll show up here.</p>
            </div>
        }
        else
        {
            <div class="notif-list">
                @foreach (var n in list)
                {
                    var iconClass = n.Type switch
                    {
                        "Course"        => "bi-play-circle-fill text-primary",
                        "Certificate"   => "bi-award-fill text-warning",
                        "Promo"         => "bi-tag-fill text-success",
                        "CoursePending" => "bi-hourglass-split text-info",
                        _               => "bi-info-circle-fill text-secondary"
                    };

                    var dotColor = n.Type switch
                    {
                        "Course"        => "bg-primary",
                        "Certificate"   => "bg-warning",
                        "Promo"         => "bg-success",
                        "CoursePending" => "bg-info",
                        _               => "bg-secondary"
                    };

                    var timeAgo = GetTimeAgo(n.CreatedAt);

                    <div class="notif-item @(n.IsRead ? "" : "notif-unread")">
                        <div class="notif-icon-wrap">
                            <i class="bi @iconClass notif-type-icon"></i>
                        </div>
                        <div class="notif-content">
                            <div class="notif-title">@n.Title</div>
                            <p class="notif-message">@n.Message</p>
                            <small class="notif-time"><i class="bi bi-clock me-1"></i>@timeAgo</small>
                        </div>
                        <div class="notif-actions">
                            @if (!n.IsRead)
                            {
                                <form asp-action="MarkRead" asp-route-id="@n.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-read" title="Mark as read">
                                        <i class="bi bi-check2"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="read-badge"><i class="bi bi-check2-all"></i> Read</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>

@functions {
    static string GetTimeAgo(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalMinutes < 1)   return "Just now";
        if (diff.TotalMinutes < 60)  return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24)    return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7)      return $"{(int)diff.TotalDays}d ago";
        if (diff.TotalDays < 30)     return $"{(int)(diff.TotalDays / 7)}w ago";
        return dt.ToString("MMM dd, yyyy");
    }
}

<style>
    /* ── Hero ────────────────────────────────────────── */
    .notifications-page { background: #f8f9fc; min-height: 100vh; }

    .notif-hero {
        background: linear-gradient(135deg, #1a1f3c 0%, #2d3a8c 60%, #4158d0 100%);
        padding: 70px 0 50px;
        position: relative;
        overflow: hidden;
    }
    .notif-hero::before {
        content: '';
        position: absolute; inset: 0;
        background: radial-gradient(circle at 80% 50%, rgba(99,102,241,.3) 0%, transparent 60%);
    }
    .notif-hero-content { position: relative; z-index: 1; }
    .notif-badge {
        display: inline-flex; align-items: center; gap: 6px;
        background: rgba(255,255,255,.12);
        color: #a5b4fc; border: 1px solid rgba(255,255,255,.2);
        border-radius: 50px; padding: 6px 18px;
        font-size: .75rem; font-weight: 700; letter-spacing: 1px;
        margin-bottom: 16px;
    }
    .notif-hero-title {
        font-size: 2.5rem; font-weight: 800;
        color: #fff; margin-bottom: 12px;
    }
    .notif-hero-sub { color: rgba(255,255,255,.7); font-size: 1.05rem; }

    /* ── Body ────────────────────────────────────────── */
    .notif-body { padding: 40px 0 80px; max-width: 800px; }

    /* ── Stats bar ───────────────────────────────────── */
    .notif-stats-bar {
        display: flex; align-items: center; gap: 20px;
        background: #fff; border-radius: 14px;
        padding: 14px 22px; margin-bottom: 24px;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        flex-wrap: wrap;
    }
    .notif-stats-bar strong { color: #1a1f3c; }
    .btn-mark-all {
        background: linear-gradient(135deg, #4158d0, #6366f1);
        color: #fff; border: none; border-radius: 8px;
        padding: 7px 16px; font-size: .85rem; font-weight: 600;
        cursor: pointer; transition: opacity .2s;
    }
    .btn-mark-all:hover { opacity: .88; }

    /* ── Notification item ───────────────────────────── */
    .notif-list { display: flex; flex-direction: column; gap: 12px; }

    .notif-item {
        display: flex; align-items: flex-start; gap: 16px;
        background: #fff; border-radius: 14px;
        padding: 20px 22px;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
        border-left: 4px solid transparent;
        transition: transform .18s, box-shadow .18s;
    }
    .notif-item:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 22px rgba(0,0,0,.1);
    }
    .notif-unread {
        border-left-color: #4158d0;
        background: #fafbff;
    }

    .notif-icon-wrap {
        width: 46px; height: 46px; border-radius: 12px;
        background: #f0f2ff;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .notif-type-icon { font-size: 1.3rem; }

    .notif-content { flex: 1; min-width: 0; }
    .notif-title { font-weight: 700; color: #1a1f3c; margin-bottom: 4px; font-size: .97rem; }
    .notif-message { color: #6b7280; font-size: .87rem; line-height: 1.5; margin-bottom: 6px; }
    .notif-time { color: #9ca3af; font-size: .78rem; }

    .notif-actions { flex-shrink: 0; display: flex; align-items: center; }
    .btn-read {
        background: #f0f2ff; border: none; color: #4158d0;
        border-radius: 8px; padding: 6px 10px; font-size: 1.1rem;
        cursor: pointer; transition: background .2s;
    }
    .btn-read:hover { background: #dde3ff; }
    .read-badge { color: #9ca3af; font-size: .8rem; white-space: nowrap; }

    /* ── Empty ───────────────────────────────────────── */
    .notif-empty {
        text-align: center; padding: 80px 20px;
        background: #fff; border-radius: 18px;
        box-shadow: 0 2px 12px rgba(0,0,0,.05);
    }
    .empty-icon {
        font-size: 4rem; color: #d1d5db; margin-bottom: 20px;
        line-height: 1;
    }
    .notif-empty h3 { color: #374151; font-weight: 700; }
    .notif-empty p { color: #9ca3af; font-size: .95rem; }
</style>
