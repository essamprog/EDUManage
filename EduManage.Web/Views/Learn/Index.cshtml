@using EduManage.Application.DTOs.Courses
@model CourseDto
@{
    Layout = null; // No dashboard layout, learning page usually takes the full screen

    int? activeLessonId = ViewData["ActiveLessonId"] as int?;
    
    // Find the active lesson object, default to the very first lesson if not specified
    var firstSection = Model.Sections.FirstOrDefault();
    CourseLessonDto? activeLesson = null;
    
    if (activeLessonId.HasValue)
    {
        activeLesson = Model.Sections.SelectMany(s => s.Lessons).FirstOrDefault(l => l.Id == activeLessonId.Value);
    }
    
    if (activeLesson == null && firstSection != null)
    {
        activeLesson = firstSection.Lessons.FirstOrDefault();
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Title - EduManage Learning</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
        body { background-color: #f8f9fa; display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
        .navbar { background-color: #212529; }
        .learning-container { display: flex; flex: 1; overflow: hidden; }
        .video-wrapper { flex: 1; background-color: #000; display: flex; flex-direction: column; overflow-y: auto; }
        .sidebar { width: 350px; background-color: #fff; border-left: 1px solid #dee2e6; display: flex; flex-direction: column; }
        .sidebar-header { padding: 15px; border-bottom: 1px solid #dee2e6; }
        .sidebar-content { flex: 1; overflow-y: auto; }
        
        .lesson-item { padding: 10px 15px; border-bottom: 1px solid #f1f3f5; cursor: pointer; display: flex; align-items: center; gap: 10px; color: #495057; text-decoration: none; }
        .lesson-item:hover { background-color: #f8f9fa; }
        .lesson-item.active { background-color: #e7f5ff; color: #0d6efd; font-weight: bold; border-left: 4px solid #0d6efd; }
        
        .accordion-button:not(.collapsed) { background-color: #f8f9fa; color: #212529; box-shadow: none; font-weight: bold; }
        .accordion-button { padding: 12px 15px; }
        .accordion-item { border: none; border-bottom: 1px solid #dee2e6; border-radius: 0 !important; }
    </style>
</head>
<body>

    <!-- Header -->
    <nav class="navbar navbar-dark py-2 px-4 shadow-sm">
        <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-arrow-left"></i>
            <span class="fs-6 text-truncate" style="max-width: 400px;">@Model.Title</span>
        </a>
    </nav>

    <!-- Main Learning Area -->
    <div class="learning-container">
        
        <!-- Video Player -->
        <div class="video-wrapper">
            @if (activeLesson != null && !string.IsNullOrEmpty(activeLesson.VideoPath))
            {
                <video src="@activeLesson.VideoPath" controls controlsList="nodownload" class="w-100" style="max-height: 80vh; background: #000;"></video>
                <div class="p-4 bg-white flex-1">
                    <h3 class="fw-bold">@activeLesson.Title</h3>
                    <p class="text-muted">Section: @(Model.Sections.FirstOrDefault(s => s.Id == activeLesson.SectionId)?.Title)</p>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center h-100 text-white flex-column">
                    <i class="bi bi-camera-video-off display-1 text-secondary mb-3"></i>
                    <h4 class="text-secondary">No video selected or video is missing</h4>
                </div>
            }
        </div>

        <!-- Curriculum Sidebar -->
        <div class="sidebar">
            <div class="sidebar-header">
                <h5 class="m-0 fw-bold">Course Content</h5>
            </div>
            <div class="sidebar-content">
                <div class="accordion" id="curriculumAccordion">
                    @for (int i = 0; i < Model.Sections.Count; i++)
                    {
                        var courseSection = Model.Sections[i];
                        bool isSectionActive = activeLesson != null && activeLesson.SectionId == courseSection.Id;
                        
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="heading-@courseSection.Id">
                                <button class="accordion-button @(isSectionActive ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@courseSection.Id">
                                    @courseSection.Title
                                </button>
                            </h2>
                            <div id="collapse-@courseSection.Id" class="accordion-collapse collapse @(isSectionActive ? "show" : "")" data-bs-parent="#curriculumAccordion">
                                <div class="accordion-body p-0">
                                    @foreach (var lesson in courseSection.Lessons)
                                    {
                                        bool isActive = activeLesson != null && activeLesson.Id == lesson.Id;
                                        <a asp-controller="Learn" asp-action="Index" asp-route-courseId="@Model.Id" asp-route-lessonId="@lesson.Id" 
                                           class="lesson-item @(isActive ? "active" : "")">
                                            <i class="bi bi-play-circle-fill @(isActive ? "text-primary" : "text-muted")"></i>
                                            <div class="d-flex flex-column">
                                                <span class="small">@lesson.Title</span>
                                                <span class="text-muted" style="font-size: 0.75rem;">@lesson.DurationMinutes min</span>
                                            </div>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
