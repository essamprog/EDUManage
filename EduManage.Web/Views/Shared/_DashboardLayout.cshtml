<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — EduManage</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    <style>
    /* ── Dashboard Layout ──────────────────────────── */
    * { box-sizing: border-box; }

    body.dashboard-body {
        margin: 0;
        background: #f4f6fb;
        font-family: 'Segoe UI', sans-serif;
        display: flex;
        min-height: 100vh;
    }

    /* ── Sidebar ─────────────────────────────────── */
    .ds-sidebar {
        width: 230px;
        min-height: 100vh;
        background: #0d1b3e;
        display: flex;
        flex-direction: column;
        position: fixed;
        top: 0; left: 0;
        z-index: 100;
        transition: width .25s;
        overflow: hidden;
    }

    /* Logo */
    .ds-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 22px 20px 18px;
        text-decoration: none;
        border-bottom: 1px solid rgba(255,255,255,.07);
        flex-shrink: 0;
    }
    .ds-logo i { color: #4299e1; font-size: 1.4rem; }
    .ds-logo span { color: #fff; font-size: 1.1rem; font-weight: 700; }
    .ds-logo strong { color: #4299e1; }

    /* Nav items */
    .ds-nav {
        flex: 1;
        overflow-y: auto;
        padding: 14px 0;
    }
    .ds-nav::-webkit-scrollbar { width: 4px; }
    .ds-nav::-webkit-scrollbar-thumb { background: rgba(255,255,255,.1); border-radius: 2px; }

    .ds-section-label {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.2px;
        color: #4a5568;
        text-transform: uppercase;
        padding: 14px 20px 6px;
    }

    .ds-link {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 10px 20px;
        color: #a0aec0;
        text-decoration: none;
        font-size: 13.5px;
        font-weight: 500;
        border-left: 3px solid transparent;
        transition: background .15s, color .15s, border-color .15s;
        position: relative;
    }
    .ds-link i { font-size: 16px; flex-shrink: 0; width: 18px; text-align: center; }
    .ds-link:hover {
        background: rgba(66,153,225,.1);
        color: #fff;
        border-left-color: #4299e1;
    }
    .ds-link.active {
        background: rgba(66,153,225,.15);
        color: #4299e1;
        border-left-color: #4299e1;
        font-weight: 600;
    }

    .ds-badge {
        margin-left: auto;
        background: #e53e3e;
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 999px;
        min-width: 18px;
        text-align: center;
    }

    /* User info bottom */
    .ds-user-box {
        padding: 16px 20px;
        border-top: 1px solid rgba(255,255,255,.07);
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }
    .ds-user-avatar {
        width: 36px; height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #4299e1, #7c3aed);
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .ds-user-name { color: #fff; font-size: 13px; font-weight: 600; line-height: 1.2; }
    .ds-user-role { color: #718096; font-size: 11px; }
    .ds-logout {
        margin-left: auto;
        color: #718096;
        font-size: 16px;
        text-decoration: none;
        transition: color .2s;
        flex-shrink: 0;
    }
    .ds-logout:hover { color: #e53e3e; }

    /* ── Main content ───────────────────────────── */
    .ds-main {
        margin-left: 230px;
        flex: 1;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    /* Top bar */
    .ds-topbar {
        background: #fff;
        border-bottom: 1px solid #e8edf2;
        padding: 14px 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 50;
    }
    .ds-page-title { font-size: 18px; font-weight: 700; color: #1a202c; margin: 0; }
    .ds-topbar-right { display: flex; align-items: center; gap: 16px; }
    .ds-home-link {
        font-size: 13px;
        color: #718096;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 5px;
        transition: color .2s;
    }
    .ds-home-link:hover { color: #4299e1; }

    /* Content */
    .ds-content {
        padding: 28px;
        flex: 1;
    }

    /* ── Mobile ─────────────────────────────────── */
    @@media (max-width: 768px) {
        .ds-sidebar { transform: translateX(-100%); }
        .ds-sidebar.open { transform: translateX(0); }
        .ds-main { margin-left: 0; }
        .ds-mobile-toggle {
            display: flex !important;
        }
    }
    .ds-mobile-toggle {
        display: none;
        background: none;
        border: none;
        font-size: 20px;
        color: #1a202c;
        cursor: pointer;
    }
    </style>
</head>

<body class="dashboard-body">

    @{
        var currentUser   = User.Identity?.Name ?? "";
        var firstName     = currentUser.Split('@')[0];
        var initials      = firstName.Length >= 2
                            ? $"{char.ToUpper(firstName[0])}{char.ToUpper(firstName[1])}"
                            : firstName.ToUpper();
        var isAdmin       = User.IsInRole("Admin");
        var isInstructor  = User.IsInRole("Instructor");
        var isStudent     = User.IsInRole("Student");
        var currentPath   = Context.Request.Path.Value ?? "";
    }

    <!-- ── Sidebar ── -->
    <aside class="ds-sidebar" id="dsSidebar">

        <a asp-controller="Home" asp-action="Index" class="ds-logo">
            <i class="bi bi-mortarboard-fill"></i>
            <span>Edu<strong>Manage</strong></span>
        </a>

        <nav class="ds-nav">

            @if (isAdmin)
            {
                <div class="ds-section-label">Admin Panel</div>

                <a class="ds-link @(currentPath == "/Admin" || currentPath == "/Admin/Index" ? "active" : "")"
                   asp-controller="Admin" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Overview
                </a>
                <a class="ds-link @(currentPath.StartsWith("/Admin/Users") ? "active" : "")"
                   asp-controller="Admin" asp-action="Users">
                    <i class="bi bi-people"></i> Users
                </a>
                <a class="ds-link @(currentPath.StartsWith("/Admin/Courses") ? "active" : "")"
                   asp-controller="Admin" asp-action="Courses">
                    <i class="bi bi-grid"></i> Courses
                </a>
                <a class="ds-link @(currentPath.StartsWith("/Admin/Pending") ? "active" : "")"
                   asp-controller="Admin" asp-action="Pending">
                    <i class="bi bi-hourglass-split"></i> Pending Approval
                </a>
                <a class="ds-link @(currentPath.StartsWith("/Admin/Finance") ? "active" : "")"
                   asp-controller="Admin" asp-action="Finance">
                    <i class="bi bi-wallet2"></i> Finance
                </a>
            }

            @if (isInstructor)
            {
                <div class="ds-section-label">Instructor</div>

                <a class="ds-link @(currentPath == "/Instructor" || currentPath == "/Instructor/Index" ? "active" : "")"
                   asp-controller="Instructor" asp-action="Index">
                    <i class="bi bi-easel"></i> Overview
                </a>
                <a class="ds-link @(currentPath.StartsWith("/Instructor/Courses") ? "active" : "")"
                   asp-controller="Instructor" asp-action="Courses">
                    <i class="bi bi-grid"></i> My Courses
                </a>
                <a class="ds-link @(currentPath.StartsWith("/Instructor/Create") ? "active" : "")"
                   asp-controller="Instructor" asp-action="Create">
                    <i class="bi bi-plus-circle"></i> Create Course
                </a>
                <a class="ds-link @(currentPath.StartsWith("/Instructor/Financials") ? "active" : "")"
                   asp-controller="Instructor" asp-action="Financials">
                    <i class="bi bi-cash-coin"></i> Financials
                </a>
            }

            @if (isStudent)
            {
                <div class="ds-section-label">Student</div>

                <a class="ds-link @(currentPath == "/Dashboard" || currentPath == "/Dashboard/Index" ? "active" : "")"
                   asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-journal-bookmark"></i> My Courses
                </a>
                <a class="ds-link @(currentPath.StartsWith("/Cart") ? "active" : "")"
                   asp-controller="Cart" asp-action="Index">
                    <i class="bi bi-cart3"></i> My Cart
                </a>
            }

            <!-- Common -->
            <div class="ds-section-label">General</div>
            <a class="ds-link" asp-controller="Courses" asp-action="Index">
                <i class="bi bi-search"></i> Browse Courses
            </a>
            <a class="ds-link" asp-controller="Instructors" asp-action="Index">
                <i class="bi bi-person-badge"></i> Instructors
            </a>
            <a class="ds-link @(currentPath.StartsWith("/Profile") ? "active" : "")" asp-controller="Profile" asp-action="Index">
                <i class="bi bi-person-circle"></i> My Profile
            </a>

        </nav>

        <!-- User box -->
        <div class="ds-user-box">
            @{
                var sidebarAvatarUrl = ViewData["SidebarAvatarUrl"] as string;
            }
            @if (!string.IsNullOrEmpty(sidebarAvatarUrl))
            {
                <img src="@sidebarAvatarUrl" alt="@firstName"
                     style="width:36px;height:36px;border-radius:50%;object-fit:cover;flex-shrink:0;" />
            }
            else
            {
                <div class="ds-user-avatar">@initials</div>
            }
            <div>
                <div class="ds-user-name">@firstName</div>
                <div class="ds-user-role">
                    @(isAdmin ? "Admin" : isInstructor ? "Instructor" : "Student")
                </div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="ds-logout" title="Logout">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
            </form>
        </div>

    </aside>

    <!-- ── Main area ── -->
    <div class="ds-main">

        <!-- Top bar -->
        <div class="ds-topbar">
            <div class="d-flex align-items-center gap-3">
                <button class="ds-mobile-toggle" onclick="document.getElementById('dsSidebar').classList.toggle('open')">
                    <i class="bi bi-list"></i>
                </button>
                <h1 class="ds-page-title">@(ViewData["Title"] ?? "Dashboard")</h1>
            </div>
            <div class="ds-topbar-right">
                <a asp-controller="Home" asp-action="Index" class="ds-home-link">
                    <i class="bi bi-house"></i> Home
                </a>
            </div>
        </div>

        <!-- Page content -->
        <div class="ds-content">

            @if (TempData["Success"] is string msg)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-check-circle-fill"></i> @msg
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] is string err)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-exclamation-triangle-fill"></i> @err
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
